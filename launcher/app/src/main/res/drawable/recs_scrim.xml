<?xml version="1.0" encoding="utf-8"?>
<!-- Over the recommendation's backdrop: dark on the left, where the title and scores sit, and fading into Home's
     black at the bottom, so the backdrop has no hard edge above Continue watching. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#E6000000" android:centerColor="#80000000"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#FF000000" android:centerColor="#66000000"
                android:centerY="0.35" android:endColor="#33000000" />
        </shape>
    </item>
</layer-list>
